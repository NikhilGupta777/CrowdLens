# ─── CrowdLens Environment Configuration ─────────────────────────────────────
# Copy this file to .env and fill in your values.

# ─── AI Assistant (Google Gemini) ─────────────────────────────────────────────
# Required for AI Reports, Chat, and Scene Narration features.
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_INTEGRATIONS_GEMINI_API_KEY=your_gemini_api_key_here

# ─── Email Alerts (AWS SES) ───────────────────────────────────────────────────
# Optional. Leave empty to disable email notifications.
ALERT_EMAIL_TO=your-email@example.com
ALERT_EMAIL_FROM=your-email@example.com
ALERT_EMAIL_COOLDOWN_SECS=45

# Path to AWS CLI binary (auto-detected if on PATH)
# AWS_CLI_BIN=/usr/local/bin/aws

# ─── Stream Security ─────────────────────────────────────────────────────────
# Set to "true" when running locally to allow campus/home IP camera connections.
# This disables SSRF protection for private IPs (192.168.x.x, 10.x.x.x, etc.)
# NEVER set to "true" in cloud/production deployments.
ALLOW_LOCAL_STREAMS=true

# ─── Fall Detection Model ─────────────────────────────────────────────────────
# Optional. If set, uses a local .pt file instead of downloading from HuggingFace.
# FALL_MODEL_LOCAL_PATH=/path/to/fall_model/best.pt

# ─── Backend URL (for frontend proxy in development) ──────────────────────────
# BACKEND_URL=http://localhost:8080
# BACKEND_WS_URL=ws://localhost:8080
